@model IEnumerable<Day04_lab.Models.Book>
@{
	ViewData["Title"] = "Index";
}

<h2>Danh sách các cuốn sách</h2>

<!-- Hiển thị các combobox trên form -->

<form action="" method="POST" class="form-inline" role="form">
	<div class="form-group">
		<select name="authorId" class="form-control" asp-items="ViewBag.authors">
			<option value="">Chọn tác giả</option>
		</select>
		<select name="genreId" class="form-control" asp-items="ViewBag.genres">
			<option value="">Chọn thể loại</option>
		</select>
	</div>
	<button type="submit" class="btn btn-primary">Tìm kiếm</button>
	<a asp-action="create" class="btn btn-danger">Thêm mới</a>
</form>
<hr />

<!-- Hiện thị danh sách các cuốn sách -->

<table class="table table-bordered">
	<thead>
		<tr>
			<th>Id</th>
			<th>Tiêu đề</th>
			<th>Tác giả</th>
			<th>Thể loại</th>
			<th>Giá</th>
			<th>Hình ảnh</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var book in Model)
		{
			<tr>
				<td>@book.id</td>
				<td>@book.title</td>
				<td>@book.authorId</td>
				<td>@book.genreId</td>
				<td>@book.price</td>
				<td>
					<img src="@book.image" alt="@book.title" width="40" />
				</td>
				<td>
					<a asp-action="edit" class="btn tbn-sm btn-primary">Sửa</a>
				</td>
			</tr>
		}
	</tbody>
</table>